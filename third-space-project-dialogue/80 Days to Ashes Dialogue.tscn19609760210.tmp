[sub_resource type="GDScript" id="GDScript_t5rd6"]
script/source = "extends Control

var current_line_index: int = 0

var dialogue_lines: Array = [
	\"Testing dialogue\",
	\"Testing if its proceeds next dialogue\",
	\"Testing end\"
]

func _ready() -> void:
	$DialoguePanel.hide()
	$NamePanel.hide()

func _on_button_pressed() -> void:
	current_line_index = 0
	$Button.hide()
	
	$CharacterSprite.show()
	$DialoguePanel.show()
	$NamePanel.show()
	$\"../NamePanel/NameLabel\".text = \"Person 1\"
	$\"../DialoguePanel/DialogueLabel\".text = dialogue_lines[current_line_index]
	
	$DialoguePanel.scale = Vector2(0.1, 0.1)
	var tween = create_tween(). set_trans(Tween.TRANS_BACK). set_ease(Tween.EASE_OUT)
	tween.tween_property($DialoguePanel, \"scale\", Vector2(1,1), 0.4)
	
func _unhandled_input(event: InputEvent) -> void:
	if $DialoguePanel.visible and (event.is_action_pressed(\"ui_accept\")) or (event is InputEventMouseButton and event.pressed):
		current_line_index += 1
		
		if current_line_index < dialogue_lines.size():
			$DialoguePanel/DialogueLabel.text = dialogue_lines[current_line_index]
		else:
			$DialoguePanel.hide()
			$NamePanel.hide()
			$CharacterSprite.hide()
			$Button.show()
"

